<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180 dp). Shown as the app tile on the
     Shield home row; the label "VilfinTV Live TV" is overlaid by the launcher. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Background gradient -->
    <path android:pathData="M0,0 h320 v180 h-320 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="320" android:endY="180"
                android:startColor="#0C1B4D"
                android:endColor="#0A192F" />
        </aapt:attr>
    </path>

    <!-- Accent bar bottom -->
    <path android:pathData="M0,168 h320 v12 h-320 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="320" android:endY="0"
                android:startColor="#64FFDA"
                android:endColor="#1D4ED8" />
        </aapt:attr>
    </path>

    <!-- Logo disc -->
    <path
        android:fillColor="#0A192F"
        android:strokeColor="#274A7F"
        android:strokeWidth="2"
        android:pathData="M64,90 m-38,0 a38,38 0 1,0 76,0 a38,38 0 1,0 -76,0" />
    <!-- V mark -->
    <path
        android:fillColor="#64FFDA"
        android:pathData="M46,70 L64,110 L82,70 L72,70 L64,92 L56,70 Z" />
    <path
        android:fillColor="#F5A623"
        android:pathData="M54,112 L74,112 L72,118 L56,118 Z" />

    <!-- Wordmark blocks (VilfinTV) -->
    <path android:fillColor="#FFFFFF" android:pathData="M130,66 h150 v14 h-150 z" android:fillAlpha="0.92" />
    <!-- Sub label bar (LIVE TV) -->
    <path android:fillColor="#64FFDA" android:pathData="M130,92 h64 v10 h-64 z" android:fillAlpha="0.85" />
    <path android:fillColor="#93A8C8" android:pathData="M130,110 h120 v7 h-120 z" android:fillAlpha="0.55" />
    <path android:fillColor="#93A8C8" android:pathData="M130,122 h96 v7 h-96 z" android:fillAlpha="0.4" />
</vector>
