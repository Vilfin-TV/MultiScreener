'use strict';

$(async function () {
    const returnRankingRoot = document.querySelector('.js-ranking-table-return');

    if (returnRankingRoot) {
        const {getEMaxisNeoRanking} = await import('../getEMaxisNeoRanking.js');

        await getEMaxisNeoRanking(returnRankingRoot);
    }
    //メインビジュアルアニメーション制御
    setTimeout(function () {
        hero();
    }, 4000);

    //選択中の要素にis-currentクラス付与
    addClass();

    //fund ranking用js
    fundRanking();

    //fund 動画用js
    fundMovie();

    //チェックボックス処理
    checkbox();

    //スクロールに応じてエフェクト
    efct();

    //カレンダー
    datePick();

    //fund chart selector
    selector();

    //guide nav
    pageGuide();

    //table select
    selectTable();

    //video player SP
    videoPlayer();

    //smooth scroll
    smoothScroll();

    //menu 開閉
    navMenu()

    // modal
    modal();

	// modal
	modalLine();

    // animation typewritter
    animeType()

    //アニメーションスキップ
    skip()

    //l-nav_leftの表示、非表示
    //処理内で参照しているクラス名「p-hero」と「l-nav_left」が存在する場合のみ有効化
    if (document.getElementsByClassName('p-hero')[0] !== undefined && document.getElementsByClassName('l-nav_left')[0] !== undefined) {
        leftNav();
    }
});




//デバイス判定
function userDevice() {
	var ua = navigator.userAgent;

	if (ua.indexOf('iPhone') > 0 || ua.indexOf('iPod') > 0 || ua.indexOf('Android') > 0 && ua.indexOf('Mobile') > 0) {
		return 'sp';
	} else if (ua.indexOf('iPad') > 0 || ua.indexOf('Android') > 0) {
		return 'tab';
	} else {
		return 'other';
	}

}

//メインビジュアルアニメーション制御
function hero() {
	var main = '.js-hero';
	var bar = '.js-hero-bar';

	var interval = 6000;

	var isCurrent = 'is-current';

	$(bar).css({ animation: 'bar ' + (interval / 1000) + 's ease infinite 1.2s' });

	setInterval(function () {
		if ($(main).find('.' + isCurrent).next().length) {
			$(main).find('.' + isCurrent).removeClass(isCurrent).next().addClass(isCurrent);
		} else {
			$(main).find('li').removeClass(isCurrent);
			$(main).find('li').eq(0).addClass(isCurrent);
		}
		$(main).find('li').css({ transitionDuration: (interval / 4000) + 's,0s', transitionDelay: '0s,' + (interval / 4000) + 's' });
		$(main).find('li.' + isCurrent).css({ transitionDuration: (interval / 4000) + 's', transitionDelay: '0s' });
	}, interval);


}


//選択中の要素にis-currentクラス付与
function addClass() {
	var main = '.js-addClass';
	var wrap = main + '-wrap';

	var isCurrent = 'is-current';

	$(main).on('click', function () {
		$(this).parents(wrap).find(main).removeClass(isCurrent);
		$(this).addClass(isCurrent);
	});

}


