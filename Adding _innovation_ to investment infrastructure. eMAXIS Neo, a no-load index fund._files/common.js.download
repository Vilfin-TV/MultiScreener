//fund 動画用js
function fundMovie() {
	var box = '.js-movie';
	var boxLen = $(box).length;
	var video = '.js-movie-video';
	var isActive = 'is-active';
	var boxTop = [];
	var winH = window.innerHeight;
	var winW = window.innerWidth;
	var i = 0;

	var line = 200;

	var device = userDevice();

	if (device === 'sp') {
		/*$(video).attr('controls','').attr('preload','metadata');*/
		$(video).attr('preload', 'metadata');
	}

	var efctUnit = function () {
		while (i < boxLen) {
			boxTop.push(Math.round($(box).eq(i).offset().top));
			if ($(window).scrollTop() > boxTop[i] + line) {
				$(box).eq(i).find(video)[0].pause();
			} else if ($(window).scrollTop() > boxTop[i] - winH + line) {
				$(box).eq(i).find(video)[0].play();
			} else {
				$(box).eq(i).find(video)[0].pause();
			}
			i++;
		} i = 0;
	};
	efctUnit();

	//表示エリアに入ってきたらクラスを付与

	$(window).on('scroll', function () {

		if (device == 'sp') {
			return;
		} else if (device == 'tab') {
			return;
		} else {
			boxTop.length = 0;
			if (winW <= 767) {
				line = 100;
			} else if (winH < 800) {
				line = 150;
			} else {
				line = 200;
			}

			efctUnit();
		};

	});
}

// SP時動画再生用
function videoPlayer() {
	var btn = $('.p-fundBox__imgPlayBtn')
	var v1 = $('#v1')
	btn.on('click', function () {
		var video = $(this).parents('.p-sepbox').find('video').get(0);
		video.play();
	})
}



//スクロールに応じてエフェクト
function efct() {
	var box = '.js-efct';
	var boxLen = $(box).length;
	var isActive = 'is-active';
	var boxTop = [];
	var winH = window.innerHeight;
	var winW = window.innerWidth;
	var i = 0;

	var line = 100;

	var efctUnit = function () {
		while (i < boxLen) {
			boxTop.push(Math.round($(box).eq(i).offset().top));
			if ($(window).scrollTop() > boxTop[i] - winH + line) {
				$(box).eq(i).addClass(isActive);
			}
			i++;
		} i = 0;
	};
	efctUnit();

	//表示エリアに入ってきたらクラスを付与
	$(window).on('scroll', function () {
		boxTop.length = 0;
		if (winW <= 767) {
			line = 100;
		} else if (winH < 800) {
			line = 100;
		} else {
			line = 100;
		}

		efctUnit();

	});
}

//チェックボックス処理
function checkbox() {
	var label = '.js-checkbox';
	var labelLen = $(label).length;
	var isCheck = 'is-check';
	var i = 0;

	var countCheck = function () {
		while (i < labelLen) {
			if ($(label).eq(i).find('input').prop('checked')) {
				$(label).eq(i).find('input').parents(label).addClass(isCheck);
			} else {
				$(label).eq(i).find('input').parents(label).removeClass(isCheck);
			}
			i++;
		} i = 0;
	};
	countCheck();

	$(label).on('change', 'input', function () {
		countCheck();
	});

}
// fumd chart selector
function selector() {
	$('.js-selector').on('click', function () {
		$('.js-selector').removeClass('is-current');
		$(this).addClass('is-current');
	})
}

// calender
function datePick() {
	if ($('#js-datepickStart').length === 0) {
		return;
	} else {
		$('#js-datepickStart').datepicker({
			dateFormat: 'yy/mm/dd'
		});
		$('#js-datepickEnd').datepicker({
			dateFormat: 'yy/mm/dd'
		});
	}

}

// guide
function pageGuide() {
	if ($('.js-pageGuide').length === 0) {
		return;
	} else {
		var pageHeight = $('body').height();
		var winHeight = $(window).height();
		var guideBody = $('.js-pageGuide');
		var guideItem = $('.js-pageGuide__inner');
		var currentPos;
		var hero = $('.p-hero');
		var heroHeight;
		var currentItemPos;

		// nav用
		var nav = $('.js-nav');
		var menu = $('.js-navMenu');
		var bar = $('.js-navBar');
		var icon = $('.js-navIcon');

		// gideItemとヒーローの比率合わせ
		function ItemHeight() {
			guideItem.height(guideBody.height() * (winHeight / pageHeight));
			heroHeight = $('.p-hero').height();
		}
		ItemHeight();
		// resize
		$(window).on('resize', function () {
			pageHeight = $('body').height();
			winHeight = $(window).height();
			currentPos = $(window).scrollTop();
			currentItemPos = guideBody.height() * (currentPos / pageHeight);
			ItemHeight();
			var width = window.innerWidth;
			var isCurrentAll = $(".js-monthall").prop('className').match(/is-current/);
			if (isCurrentAll) {
				isCurrentAll = isCurrentAll[0];
				if (width > 768 && isCurrentAll == 'is-current') {
					var currentRateElm = $(".js-fundranking-btn").find('li.before-flg').first();
					var currentRate = currentRateElm.prop('className').match(/[0-9]+/)[0];
					$(".js-month" + currentRate).trigger("click");
				}
			}
		})

		// ページの高さ : 画面の高さ = ガイドのボディ : ガイドアイテム
		// スクロールイベント
		$(window).on('scroll', function (e) {
			// 現在の画面位置
			currentPos = $(window).scrollTop();

			// ガイドボディの高さ分発火位置の調整
			if (currentPos + guideItem.position().top + guideItem.height() >= heroHeight) {
				guideItem.addClass('js-pageGuide__inner--green')
			} else if (currentPos + guideBody.position().top <= heroHeight) {
				guideItem.removeClass('js-pageGuide__inner--green')
			}
			// ガイドアイテムの位置　＝　ガイドボディの高さ(現在の画面位置　/ ページ高さ)
			currentItemPos = guideBody.height() * (currentPos / pageHeight);
			guideItem.css({ top: currentItemPos });
			//nav icon
			throughLine(bar.eq(0));
			throughLine(bar.eq(1));
			throughLine(bar.eq(2));
			throughLine(menu);
			throughLine(icon.eq(0));
			throughLine(icon.eq(1));

		})

		function throughLine(obj) {
			if (obj === undefined) { obj = 0 }
			if (currentPos + nav.position().top + obj.position().top + obj.height() >= heroHeight) {
				obj.addClass('is-active')
			} else if (currentPos + nav.position().top + obj.height() <= heroHeight) {
				obj.removeClass('is-active')
			}
		}

	} //false

}

// table 選択　
function selectTable() {
	var btn = $('.js-selectTableBtn');
	var month = $('.js-selectMonth');
	var table = $('.js-selectTable');

	$('.js-month1').addClass('is-current');

	btn.on('click', function () {
		var data = $(this).data();

		switch (data.table) {
			case 1:
				table.eq(0).removeClass('is-current'); // 販売額（月次）非表示
				table.eq(1).removeClass('is-current'); // 純資産残高（月次）非表示
				// table.eq(2).attr({ style: 'display:block' }); // リターン表示
				$('#rankListAll').attr({ style: 'display:block' }); //リターン表示
				month.addClass('is-current'); // リターン表示領域表示

				$('#weekday').attr({ style: 'display:block' }); // 営業日表示
				$(".rate_disc").attr({ style: 'display:block' }); // リターン用ディスクレーマ表示制御
				$(".property_disc").attr({ style: 'display:none' }); // 純資産総額用ディスクレーマ表示制御
				$(".settei_disc").attr({ style: 'display:none' }); // 販売額用ディスクレーマ表示制御
				break;
			case 2:
				table.eq(0).addClass('is-current'); // 販売額（月次）表示
				table.eq(1).removeClass('is-current'); // 純資産残高（月次）非表示
				// table.eq(2).attr({ style: 'display:none' }); // リターン非表示
				$('#rankListAll').attr({ style: 'display:none' }); //リターン非表示
				month.removeClass('is-current'); // リターン表示領域非表示

				$('#weekday').attr({ style: 'display:none !important' }); // 営業日非表示
				$(".rate_disc").attr({ style: 'display:none' }); // リターン用ディスクレーマ表示制御
				$(".property_disc").attr({ style: 'display:none' }); // 純資産総額用ディスクレーマ表示制御
				$(".settei_disc").attr({ style: 'display:block' }); // 販売額用ディスクレーマ表示制御
				break;
			case 3:
				table.eq(0).removeClass('is-current'); // 販売額（月次）非表示
				table.eq(1).addClass('is-current'); // 純資産残高（月次）表示
				// table.eq(2).attr({ style: 'display:none' }); // リターン非表示
				$('#rankListAll').attr({ style: 'display:none' }); //リターン非表示
				month.removeClass('is-current'); // リターン表示領域非表示

				$('#weekday').attr({ style: 'display:none !important' }); // 営業日非表示
				$(".rate_disc").attr({ style: 'display:none' }); // リターン用ディスクレーマ表示制御
				$(".property_disc").attr({ style: 'display:block' }); // 純資産総額用ディスクレーマ表示制御
				$(".settei_disc").attr({ style: 'display:none' }); // 販売額用ディスクレーマ表示制御
				break;

		}
	})

}


// scroll

function smoothScroll() {
	$(function () {
		$('.js-smscroll').on('click',function () {
			var speed = 500;
			var href = $(this).attr("href");
			var target = $(href == "#" || href == "" ? 'html' : href);
			var position = target.offset().top;
			$("html, body").animate({ scrollTop: position - 40 }, speed, "swing");
			return false;
		});
	});
}

function navMenu() {
	var menu = $('.js-menu')
	menu.on('click', function () {
		if ($(this).hasClass('is-active')) {
			$(this).removeClass('is-active')
		} else {
			$(this).addClass('is-active')
		}
	})
}

function modal() {
	var $mdl_btn = $('.js-modal-btn');
	var $mdl = $('.js-modal');
	var $mdl_box = $('.js-modal_box');
	var $close_area;
	var $div = $('<div>');

	$close_area = $div.addClass('close-area');
	$mdl_box.append($close_area);

	for (var i = 1; i <= 2; i++) {
		var $span = $('<span>');
		$close_area.append($span);
	}

	$mdl_btn.on('click', function () {
		$mdl.fadeIn();
	});

	$close_area.on('click', function () {
		$mdl.fadeOut();
	});

	//マスクをクリックしたらポップアップを削除する。
	$mdl.on('click', function () {
		$mdl.fadeOut();
	});

	//中身の画像をクリックした場合はなにもしない。
	$mdl_box.on('click', function (e) {
		e.stopPropagation();
	});
}

function modalLine() {
	var $mdl_btn2 = $('.js-modal-line-btn');
	var $mdl2 = $('.js-modal-Line');
	var $mdl_box2 = $('.js-modal-Line_box');
	var $close_area;
	var $div = $('<div>');

	$close_area = $div.addClass('close-area');
	$mdl_box2.append($close_area);

	for (var i = 1; i <= 2; i++) {
		var $span = $('<span>');
		$close_area.append($span);
	}

	$mdl_btn2.on('click', function () {
		$mdl2.fadeIn();
	});

	$close_area.on('click', function () {
		$mdl2.fadeOut();
	});

	//マスクをクリックしたらポップアップを削除する。
	$mdl.on('click', function () {
		$mdl2.fadeOut();
	});

	//中身の画像をクリックした場合はなにもしない。
	$mdl_box2.on('click', function (e) {
		e.stopPropagation();
	});
};

function animeType() {
	var $jsObj = $('.js-txt');
	var $jsTxt = $jsObj.text();
	var $txt = $jsTxt.slice('')

	$('.p-anim__inner__txt').css({
		'animation-name': 'none'
	})
	$('.p-anim__inner__img1').css({
		'animation-name': 'none',
		'opacity': '0',
		'left': '-380px',
	})
	$('.p-anim__inner__img2').css({
		'animation-name': 'none',
		'opacity': '0',
		'left': '-380px'
	})
	$('.p-anim').css({
		'animation-name': 'none',
		'right': '0px'
	})

	$jsObj.html('')

	for (var i = 0; i < $txt.length; i++) {
		if (i === 0) {
			var t = '<span class="js-anime-txt">' + $txt[i] + '</span>'
			$jsObj.eq(0).html(t)
		} else {
			var t = t + '<span class="js-anime-txt">' + $txt[i] + '</span>'
			$jsObj.eq(0).html(t)
		}
	}
	var $jsAnim = $('.js-anime-txt');

	setTimeout(function () {
		for (var i = 0; i < $jsAnim.length; i++) {
			$jsAnim.eq(i).delay(80 * i).animate({
				'opacity': '1',
			}, 80)
		}
	}, 1000)
	setTimeout(function () {
		$('.p-anim__inner__img1').delay(80 * i).animate({
			'opacity': '1',
			'left': '-120px',
		}, 300)
	}, 2000)
	setTimeout(function () {
		$('.p-anim__inner__img2').delay(80 * i).animate({
			'opacity': '1',
			'left': '-80px',
		}, 300)
	}, 2000)
	setTimeout(function () {
		$('.p-anim').delay(80 * i).animate({
			'right': '-100vw',
		}, 300)
	}, 3500)
}

function skip() {
	$('.js-skip').on('click', function () {
		$('.p-anim').css({
			'animation-name': 'none',
			'width': '0',
			'transition': 'width .5s cubic-bezier(0.86, 0, 0.2, 0.99)'
		})
	})
}



function leftNav() {

	$(window).on('scroll', function () {

		var currentPos = $(window).scrollTop();
		var thisOffset = $('.p-hero').offset().top + $('.p-hero').outerHeight();

		if( currentPos > thisOffset ){
	 		$('.l-nav_left').removeClass('hidden');
		}else{
			$('.l-nav_left').addClass('hidden');

		 }

	});


}

